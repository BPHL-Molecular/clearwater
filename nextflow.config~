// 1. Global Apptainer Configuration (Kept outside profiles)

process.executor = 'local'
// process.executor = 'local' tells Nextflow to run all the bioinformatics steps directly in single Slurm compute node
process {
    executor = 'local'
}

executor {
    name   = 'local'
    cpus   = 16
    memory = '128 GB'
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir    = "${projectDir}/apptainer_cache"
    // Explicitly override engine discovery so it never has to look up 'apptainer' in the PATH
    runOptions    = '--no-home'
}

// 1. Enable both engines globally

conda.enabled = true

// Tell Nextflow exactly where the engine lives so it doesn't search for the short command name
singularity {
    enabled = false // Disable old legacy engine flags to avoid collisions
}

trace.overwrite = true


// 2. Profiles Block
profiles {
    cluster {
        executor {
            name = 'slurm'
            queueSize = 2  
        }

        process {
            // --- DEFAULT FALLBACK FOR UNLISTED PROCESSES ---
            executor = 'slurm'
            cpus     = 1
            memory   = '4 GB'
            time     = '2h'

            // --- HEAVY ANALYTICS PROCESSES ---
            withName: ksnp4 {
                cpus   = 4       
                memory = '16 GB' 
                time   = '4h'
            }

            withName: checkm_qc {
                cpus   = 4       
                memory = '32 GB' 
                time   = '3h'
                errorStrategy = 'retry' 
                maxRetries    = 2
            }

            // --- DATABASE & SEARCH PROCESSES ---
            withName: kraken_subs {
                cpus   = 4        // Kraken benefits from multi-threading
                memory = '16 GB'  // Adjust based on your krakenSub_db size
                time   = '2h'
            }

            withName: proc_mash {
                cpus   = 2
                memory = '4 GB'
                time   = '1h'
            }

            // --- TYPING & ANNOTATION PROCESSES ---
            withName: elgato4mlst {
                cpus   = 2
                memory = '4 GB'
                time   = '1h'
            }

            withName: legsta {
                cpus   = 1
                memory = '2 GB'
                time   = '30m'
            }

            withName: prokka {
                cpus   = 4        // Prokka loves multi-threading
                memory = '8 GB'
                time   = '2h'
            }

            // --- LIGHTWEIGHT PYTHON REPORTING PROCESSES ---
            // These are fast and lightweight, so they can use minimal resources
            withName: 'pyProc1|pyProc4|pyProc5|pyProc7' { //|runFastANI was there
                cpus   = 2
                memory = '4 GB'
                time   = '30m'
            }

            //withName: '*runFastANI*' {
                // 1. Initial base configuration parameters
                //cpus   = 4
                //memory = { 16.GB * task.attempt } // Scales: 16GB -> 32 GB -> 48 GB on retries
                //time   = '2h'

                // 2. ERROR RESCUEsafety-net: If exit status is 137, 139, or 143 (OOM errors), 
                // retry the job automatically with the scaled memory resource allocations!
               // errorStrategy = { task.exitStatus == 137 ? 'retry' : 'finish' }
               // maxRetries    = 3
            //}

                   
        }
    }

    apptainer {
        process {
            container = 'docker://ubuntu:latest'
        }
    }

}