// GLOBAL FAILURE PERMANENT SCRUBBER: 
// This deletes temporary work directories automatically when a task finishes successfully!
cleanup = true

// This acts as a safety net (In case user forgets metadata line in params.yaml)
// Establish pipeline parameter fallback defaults
params.metadata = false
params.output   = "output"
params.snp_threshold = 3 // a standard default threshold
params.cgmlst_threshold  = 7

// 1. Global Apptainer Configuration (Kept outside profiles)

process.executor = 'local'
// process.executor = 'local' tells Nextflow to run all the bioinformatics steps directly in single Slurm compute node
process {
    executor = 'local'
}

executor {
    name   = 'local'
    cpus   = 16
    memory = '128 GB'
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir    = "${projectDir}/apptainer_cache"
    // Explicitly override engine discovery so it never has to look up 'apptainer' in the PATH
    // prevent the container from mounting the cluster account's local home directory ($HOME)
    runOptions    = '--no-home'
}

// 2. Enable both engines globally

conda.enabled = true

// Tell Nextflow exactly where the engine lives so it doesn't search for the short command name
singularity {
    enabled = false // Disable old legacy engine flags to avoid collisions
}
// Wiping out the old trace.txt file from your previous run 
trace.overwrite = true

// 3. Profiles Block
profiles {
    cluster {
        executor {
            name = 'slurm'
            queueSize = 2 // submitting a maximum of 2 tasks simultaneously  
        }

        process {
            // --- DEFAULT FALLBACK FOR UNLISTED PROCESSES ---
            executor = 'slurm'
            cpus     = 1
            memory   = '4 GB'
            time     = '2h'

            // --- HEAVY ANALYTICS PROCESSES ---
            withName: ksnp4 {
                cpus   = 4       
                memory = '16 GB' 
                time   = '4h'
            }

            withName: checkm_qc {
                cpus   = 4       
                memory = '32 GB' 
                time   = '3h'
                errorStrategy = 'retry' //Automatically re-execute a process task if it fails
                maxRetries    = 2
            }

            // --- DATABASE & SEARCH PROCESSES ---
            withName: kraken_subs {
                cpus   = 4        // Kraken benefits from multi-threading
                memory = '16 GB'  // Adjust based on your krakenSub_db size
                time   = '2h'
            }

            withName: proc_mash {
                cpus   = 2
                memory = '4 GB'
                time   = '1h'
            }

            // --- TYPING & ANNOTATION PROCESSES ---
            withName: elgato4mlst {
                cpus   = 2
                memory = '4 GB'
                time   = '1h'
            }

            withName: legsta {
                cpus   = 1
                memory = '2 GB'
                time   = '30m'
            }

            withName: prokka {
                cpus   = 4        // Prokka loves multi-threading
                memory = '8 GB'
                time   = '2h'
            }

            // --- LIGHTWEIGHT PYTHON REPORTING PROCESSES ---
            // Fast and lightweight, requiring minimal resources
            withName: 'pyProc1|pyProc4|pyProc5|pyProc7' {
                cpus   = 2
                memory = '4 GB'
                time   = '30m'
            }

            // This allows chewBBACA to run inside its dedicated container, ignoring conda env
            withName: 'run_chewbbaca_cgmlst' {
                conda = null
		cpus   = 8
                memory = '32 GB'
                time   = '4h'
            }

            // MOB-suite Container and Resource Allocation Router
            withName: 'RUN_MOB_TYPER' {
                conda  = null
                cpus   = 4
                memory = '16 GB'
                time   = '2h'
            }

            


                            
        }
    }

    apptainer {
        process {
            container = 'docker://ubuntu:latest'
        }
    }

}